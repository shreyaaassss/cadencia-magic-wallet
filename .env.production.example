# Cadencia Production Environment — Template
# Real secrets managed via AWS Secrets Manager with automated rotation.
#
# Copy this file to .env.production and fill in real values.
# NEVER commit .env.production to version control.

# ── Database ──────────────────────────────────────────────────
DATABASE_HOST=<from-aws-secrets-manager>
DATABASE_PORT=5432
DATABASE_NAME=cadencia
DATABASE_USER=<from-aws-secrets-manager>
DATABASE_PASSWORD=<from-aws-secrets-manager>

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=<from-aws-secrets-manager>
REDIS_PASSWORD=<from-aws-secrets-manager>

# ── JWT (RS256 asymmetric keys) ───────────────────────────────
JWT_PRIVATE_KEY=<from-aws-secrets-manager>
JWT_PUBLIC_KEY=<from-aws-secrets-manager>

# ── Algorand ──────────────────────────────────────────────────
ALGORAND_ESCROW_CREATOR_MNEMONIC=<from-aws-secrets-manager>
ALGORAND_NETWORK=testnet
ALGORAND_NODE_URL=https://testnet-api.algonode.cloud

# ── LLM API Keys ─────────────────────────────────────────────
GROQ_API_KEY=<from-aws-secrets-manager>
GEMINI_API_KEY=<from-aws-secrets-manager>

# ── Admin ─────────────────────────────────────────────────────
ADMIN_EMAIL=<from-aws-secrets-manager>
ADMIN_PASSWORD=<from-aws-secrets-manager>

# ── x402 ──────────────────────────────────────────────────────
X402_PAYMENT_SECRET=<from-aws-secrets-manager>

# ── Webhooks ──────────────────────────────────────────────────
WEBHOOK_SECRET=<from-aws-secrets-manager>
