# ─── Cadencia Frontend Environment Variables ──────────────────────────────

# API Base URL — points to the backend FastAPI server
NEXT_PUBLIC_API_URL=http://localhost:8000

# Mock Service Worker — set to "true" to use MSW mocks instead of real API
# Use "true" for local development without a backend, "false" for production
NEXT_PUBLIC_ENABLE_MOCKS=false

# ── Magic.link Embedded Wallet ───────────────────────────────────────────────
# Get your publishable key from https://dashboard.magic.link/
NEXT_PUBLIC_MAGIC_PUBLISHABLE_KEY=pk_live_REPLACE_WITH_YOUR_KEY

# Algorand node RPC URL used by the Magic extension and x402 client
# TestNet: https://testnet-api.algonode.cloud
# MainNet: https://mainnet-api.algonode.cloud
NEXT_PUBLIC_ALGORAND_NODE_URL=https://testnet-api.algonode.cloud

# Set to "true" to enable x402 payment UI (WalletWidget payment history, etc.)
NEXT_PUBLIC_X402_ENABLED=true
