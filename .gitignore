# ── Environment & Secrets ────────────────────────────────────
# All .env variants (case-insensitive on Windows, explicit for Linux/Mac)
.env
.ENV
.env.local
.ENV.local
.env.*.local
.env.production
**/.env
**/.ENV
# Never commit real credentials — use .env.example as template
# NOTE: supabase-root-ca.pem is intentionally tracked — required by Dockerfile
# *.pem is NOT globally excluded to allow supabase-root-ca.pem to be committed

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
dist/
build/
.venv/
venv/

# ── Node ─────────────────────────────────────────────────────
node_modules/
.next/
out/
*.tsbuildinfo

# ── Docker ───────────────────────────────────────────────────
docker-compose.override.yml

# ── IDE ──────────────────────────────────────────────────────
.vscode/
.idea/
.cursor/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Agent/AI config ──────────────────────────────────────────
.claude/
.gemini/
.trae/

# ── Logs & runtime output ────────────────────────────────────
*.log
seed_output.txt
seed_run_log.txt
backend_logs.txt
simulation_output.txt

# ── AWS deploy keys ──────────────────────────────────────────
# Block AWS/SSH key files but NOT supabase-root-ca.pem (required by Dockerfile)
*.pem
!supabase-root-ca.pem
!backend/supabase-root-ca.pem

# ── Terraform state ──────────────────────────────────────────
*.tfstate
*.tfstate.*
.terraform/

# ── Temp / scratch files ──────────────────────────────────────
backend_env_b64.txt
*_env_b64.txt
scratch/
*.jpeg
*.jpg
*.png

# ── Compiled contract artifacts (regenerate from source) ──────
backend/artifacts/*.teal
backend/artifacts/*.b64

# ── Audit / one-off docs (not for public repo) ───────────────
*_audit.md
*_audit_report*.md
*_plan.md
*_plan_v*.md
*_integration.md
*_testing_plan.md
*_implementation_plan.md
openai-key.txt
instance-deploy-log.md
TESTING_GUIDE.md
cadencia_audit_report.md
deep_issue_review_and_plan.md
dead_code_audit.md
rfq_standard_format.md

# ── Non-code files ────────────────────────────────────────────
*.pdf
test_bulk_catalogue.csv
